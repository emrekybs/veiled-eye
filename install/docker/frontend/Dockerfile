##############################################################################
# Dockerfile — Veiled Eye web UI (nginx:alpine)
#
# The built UI is committed under backend/frontend_dist (generated by
# tools/ui_build/patch.py), so the image builds offline and always matches
# the backend it ships with.
##############################################################################

FROM nginx:alpine

RUN apk add --no-cache curl

COPY backend/frontend_dist/ /usr/share/nginx/html/

# SPA routing + API proxy + security headers
COPY install/docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/health || exit 1
